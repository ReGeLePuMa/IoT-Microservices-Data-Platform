      "targets": [
        {
          "query": "from(bucket: \"tema3\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r[\"key\"] == \"BAT\")\r\n  |> aggregateWindow(every: 1s, fn: mean, createEmpty: false)\r\n  |> reduce(\r\n    fn: (r, accumulator) => ({\r\n      station: r.station,\r\n      current: r._value,\r\n      min: if exists(accumulator.min) then if r._value < accumulator.min then r._value else accumulator.min else r._value,\r\n      max: if exists(accumulator.max) then if r._value > accumulator.max then r._value else accumulator.max else r._value,\r\n      sum: accumulator.sum + r._value,\r\n      count: accumulator.count + 1\r\n    }),\r\n    identity: {station: \"\", current: 0.0, min: 0.0, max: 0.0, sum: 0.0, count: 0}\r\n  )\r\n\r\n  |> map(fn: (r) => ({\r\n    station: r.station,\r\n    current: r.current,\r\n    min: r.min,\r\n    max: r.max,\r\n    avg: r.sum / float(v: r.count)\r\n  }))\r\n  |> yield(name: \"Battery Statistics\")\r\n",
          "refId": "A"
        }
      ],
